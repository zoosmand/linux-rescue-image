" use mouse as a pointer
set mouse=a
" use colorscheme
colorscheme morning
" use syntax highlight
syntax on
" ignore case in search
set ignorecase
" show number on line
set number
" uee relative number of line
set relativenumber
" show existing tab with 4 spaces width
set tabstop=4
" when indenting with '>', use 4 spaces width
set shiftwidth=4
" On pressing tab, insert 4 spaces
set expandtab
